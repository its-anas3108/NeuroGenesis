{
  "paths": {
    "project_root": ".",
    "mri_dir": "dataset/OASIS_synthetic",
    "metadata_csv": "dataset/oasis_cross-sectional.csv",
    "atlas_dir": "dataset/nilearn_data",
    "outputs_dir": "outputs_imaging",
    "experiment_id": "default"
  },
  "data": {
    "cdr_to_stage": {
      "0.0": "CN",
      "0.5": "MCI",
      "1.0": "AD",
      "2.0": "AD"
    },
    "missing_cdr_policy": "exclude",
    "min_age": null,
    "max_age": null,
    "val_fraction": 0.15,
    "test_fraction": 0.2,
    "n_repeats": 10
  },
  "preprocess": {
    "target_shape": [
      128,
      128,
      128
    ],
    "interpolator": "linear",
    "gaussian_sigma": 1.0,
    "aniso_iterations": 10,
    "aniso_conductance": 3.0,
    "clahe_clip_limit": 0.03,
    "morph_radius": 4,
    "min_quality_score": 50.0,
    "skip_failed_qc": false,
    "gm_threshold": 0.3,
    "atlas_name": "cort-maxprob-thr25-2mm",
    "patch_size": [
      48,
      48,
      48
    ],
    "context_pad": 4,
    "save_nifti": true,
    "save_figures": false,
    "max_subjects": 9
  },
  "spatial_encoder": {
    "channels": [
      16,
      32,
      64
    ],
    "kernel_size": 3,
    "embed_dim": 128,
    "dropout": 0.2,
    "shared_encoder": true
  },
  "neuropropx": {
    "alpha_logit_init": 0.0,
    "learn_alpha": true,
    "attention_hidden": 64,
    "anp_use_topology": true,
    "sagr_use_centrality": true
  },
  "graph_learning": {
    "hidden_dim": 64,
    "heads": 4,
    "n_layers": 2,
    "dropout": 0.2,
    "negative_slope": 0.2,
    "readout": "mean_max",
    "use_edge_gate": true
  },
  "fusion": {
    "hidden_dim": 128,
    "out_dim": 64,
    "dropout": 0.3
  },
  "stage_tgt": {
    "d_model": 64,
    "n_heads": 4,
    "n_layers": 2,
    "ff_dim": 128,
    "dropout": 0.1,
    "enabled": true
  },
  "loss": {
    "lambda_proto": 1.0,
    "lambda_order": 0.5,
    "lambda_align": 0.3,
    "order_margin": 0.5,
    "imbalance": "class_weighted",
    "label_smoothing": 0.0
  },
  "train": {
    "epochs": 120,
    "batch_size": 16,
    "lr": 0.001,
    "weight_decay": 0.0001,
    "monitor": "balanced_accuracy",
    "early_stopping_patience": 25,
    "tie_break_on_geometry": true,
    "tie_break_tolerance": 1e-06,
    "grad_clip": 1.0,
    "device": "auto",
    "num_workers": 0
  },
  "ranking": {
    "lambda_vulnerability": 0.4,
    "lambda_attention": 0.3,
    "lambda_shap": 0.3
  },
  "stats": {
    "alpha": 0.05,
    "fdr_method": "benjamini_hochberg",
    "normality_test": "shapiro",
    "normality_alpha": 0.05,
    "min_group_n": 5
  },
  "repro": {
    "seed": 42,
    "deterministic": true,
    "cudnn_benchmark": false
  }
}